#!/bin/sh
# Fixed joystick-node address. The NSU is on the same subnet (no gateway is
# required for the outbound WebSocket link).
DEV=eth0
ADDR=192.168.127.251
PREFIX=24

case "$1" in
    start)
        ip link set "$DEV" up 2>/dev/null || true
        ip addr flush dev "$DEV" 2>/dev/null || true
        ip addr add "$ADDR/$PREFIX" dev "$DEV"
        ;;
    stop)
        ip addr flush dev "$DEV" 2>/dev/null || true
        ;;
    restart)
        "$0" stop
        sleep 1
        "$0" start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac
